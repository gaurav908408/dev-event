<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 600" width="820" height="600">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f0c1b" />
      <stop offset="50%" stop-color="#181534" />
      <stop offset="100%" stop-color="#070510" />
    </linearGradient>
    <linearGradient id="accent2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a855f7" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>
    <linearGradient id="glow2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="820" height="600" fill="url(#bg2)" rx="16" />

  <!-- Grid lines -->
  <g stroke="#ffffff" stroke-opacity="0.04" stroke-width="1">
    <line x1="0" y1="100" x2="820" y2="100" />
    <line x1="0" y1="200" x2="820" y2="200" />
    <line x1="0" y1="300" x2="820" y2="300" />
    <line x1="0" y1="400" x2="820" y2="400" />
    <line x1="0" y1="500" x2="820" y2="500" />
    <line x1="150" y1="0" x2="150" y2="600" />
    <line x1="300" y1="0" x2="300" y2="600" />
    <line x1="450" y1="0" x2="450" y2="600" />
    <line x1="600" y1="0" x2="600" y2="600" />
    <line x1="750" y1="0" x2="750" y2="600" />
  </g>

  <!-- Decorative Glow Circle -->
  <circle cx="650" cy="200" r="230" fill="url(#glow2)" />
  <circle cx="650" cy="200" r="150" stroke="url(#accent2)" stroke-width="2" stroke-dasharray="8,8" fill="none" opacity="0.6" />

  <!-- Network / Globe graphic -->
  <g transform="translate(650, 200)" stroke="url(#accent2)" stroke-width="3" fill="none" opacity="0.8">
    <circle r="70" stroke-width="2" />
    <ellipse rx="70" ry="25" stroke-width="2" />
    <ellipse rx="25" ry="70" stroke-width="2" />
    <circle cx="-40" cy="-30" r="6" fill="#38bdf8" />
    <circle cx="50" cy="20" r="6" fill="#a855f7" />
    <circle cx="10" cy="-55" r="6" fill="#38bdf8" />
  </g>

  <!-- Tag / Badge -->
  <rect x="60" y="70" width="145" height="36" rx="18" fill="#a855f7" fill-opacity="0.2" stroke="#a855f7" stroke-width="1.5" />
  <circle cx="82" cy="88" r="5" fill="#a855f7" />
  <text x="96" y="93" fill="#c084fc" font-family="system-ui, sans-serif" font-size="14" font-weight="700" letter-spacing="1">CONFERENCE</text>

  <!-- Main Title -->
  <text x="60" y="220" fill="#ffffff" font-family="system-ui, sans-serif" font-size="52" font-weight="800">Global Web3 &amp;</text>
  <text x="60" y="285" fill="url(#accent2)" font-family="system-ui, sans-serif" font-size="52" font-weight="800">Dev Summit 2026</text>

  <!-- Description -->
  <text x="60" y="345" fill="#bdbdbd" font-family="system-ui, sans-serif" font-size="20" font-weight="400">The ultimate gathering for developers &amp; architects.</text>
  <text x="60" y="375" fill="#bdbdbd" font-family="system-ui, sans-serif" font-size="20" font-weight="400">Keynotes, workshops &amp; networking with industry leaders.</text>

  <!-- Footer Info Bar -->
  <rect x="60" y="460" width="700" height="70" rx="12" fill="#181534" stroke="#2a2456" stroke-width="2" />
  <text x="90" y="502" fill="#e7f2ff" font-family="system-ui, sans-serif" font-size="18" font-weight="600">📅 NOV 10 - 12, 2026</text>
  <text x="360" y="502" fill="#e7f2ff" font-family="system-ui, sans-serif" font-size="18" font-weight="600">📍 BENGALURU &amp; HYBRID</text>
  <text x="620" y="502" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="18" font-weight="700">PASSES</text>
</svg>
